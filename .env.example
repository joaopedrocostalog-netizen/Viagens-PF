# Arquivo de exemplo. Nunca envie .env real para o GitHub.
PORT=3001
PORTAL_ACCESS_TOKEN=GERAR_TOKEN_FORTE_PRIVADO
PORTAL_ALLOWED_ORIGINS=https://joaopedrocostalog-netizen.github.io,https://portal.suaempresa.com.br
DSS_BASE_URL=https://costalog.dssinformatica.com.br/wsdss
DSS_AUTH_HEADER=Authorization
DSS_AUTH_VALUE=Bearer TOKEN_PRIVADO_DSS
DSS_TIMEOUT_MS=20000

# Preencher somente depois de consultar o Swagger. Sem endpoints fictícios.
DSS_VIAGENS_PATH=
DSS_VIAGENS_METHOD=GET
DSS_VIAGENS_QUERY_FROM=
DSS_VIAGENS_QUERY_TO=
DSS_VIAGENS_DATA_PATH=
DSS_VIAGENS_BODY_TEMPLATE=

DSS_PEDIDOS_PATH=
DSS_PEDIDOS_METHOD=GET
DSS_PEDIDOS_QUERY_FROM=
DSS_PEDIDOS_QUERY_TO=
DSS_PEDIDOS_DATA_PATH=
DSS_PEDIDOS_BODY_TEMPLATE=

# Operações opcionais para conciliação documental.
DSS_CTES_PATH=
DSS_CTES_METHOD=GET
DSS_CTES_QUERY_FROM=
DSS_CTES_QUERY_TO=
DSS_CTES_DATA_PATH=
DSS_CTES_BODY_TEMPLATE=

DSS_MDFES_PATH=
DSS_MDFES_METHOD=GET
DSS_MDFES_QUERY_FROM=
DSS_MDFES_QUERY_TO=
DSS_MDFES_DATA_PATH=
DSS_MDFES_BODY_TEMPLATE=

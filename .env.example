# Arquivo de exemplo. Nunca envie .env real para o GitHub.
PORT=3001
# CONTAS INDIVIDUAIS (novo modo seguro):
PORTAL_USERS_FILE=/app/private/portal-users.json
# Tokens antigos só funcionam se PORTAL_USERS_FILE estiver totalmente ausente.
# Na produção com contas individuais, NÃO configure o token administrativo legado.
PORTAL_ALLOW_LEGACY_TOKEN=false
# PORTAL_ACCESS_TOKEN=
PORTAL_ALLOWED_ORIGINS=https://joaopedrocostalog-netizen.github.io,https://portal.suaempresa.com.br
DSS_BASE_URL=https://costalog.dssinformatica.com.br/wsdss
# Autenticação de usuário e senha no DSS (Basic Auth) — somente servidor
DSS_AUTH_TYPE=basic
DSS_USERNAME=SEU_USUARIO_DSS
DSS_PASSWORD=SUA_SENHA_DSS
# Alternativa para outras instalações: DSS_AUTH_TYPE=header + DSS_AUTH_HEADER/DSS_AUTH_VALUE
# No modo Basic, os dois campos abaixo não são usados.
DSS_AUTH_HEADER=
DSS_AUTH_VALUE=
DSS_TIMEOUT_MS=20000

# Rotas e parâmetros confirmados pela documentação enviada. Confirme o prefixo/base URL e autenticação do servidor.
DSS_VIAGENS_PATH=/listarViagens
DSS_VIAGENS_METHOD=GET
DSS_VIAGENS_QUERY_FROM=data_inicio
DSS_VIAGENS_QUERY_TO=data_fim
DSS_VIAGENS_DATA_PATH=registros
DSS_VIAGENS_BODY_TEMPLATE=

DSS_PEDIDOS_PATH=/listarPedidosFrete
DSS_PEDIDOS_METHOD=GET
DSS_PEDIDOS_QUERY_FROM=data_inicio
DSS_PEDIDOS_QUERY_TO=data_fim
DSS_PEDIDOS_DATA_PATH=registros
DSS_PEDIDOS_BODY_TEMPLATE=

# Operações opcionais para conciliação documental.
DSS_CTES_PATH=
DSS_CTES_METHOD=GET
DSS_CTES_QUERY_FROM=
DSS_CTES_QUERY_TO=
DSS_CTES_DATA_PATH=
DSS_CTES_BODY_TEMPLATE=

DSS_MDFES_PATH=
DSS_MDFES_METHOD=GET
DSS_MDFES_QUERY_FROM=
DSS_MDFES_QUERY_TO=
DSS_MDFES_DATA_PATH=
DSS_MDFES_BODY_TEMPLATE=

# Cache temporário em memória (nunca é exposto no GitHub Pages)
API_CACHE_SECONDS=60
# Limitação básica por IP (em proxy reverso, a origem pode ser o endereço do proxy)
PORTAL_REQUESTS_PER_MINUTE=600

# Cadastro opcional de motoristas: rota informada pela DSS. Sem parâmetros até confirmar o Swagger.
# Se o fornecedor retornar campos diferentes, personalize ID_FIELD/NAME_FIELD/DATA_PATH.
DSS_MOTORISTAS_PATH=/listarMotoristas
DSS_MOTORISTAS_DATA_PATH=registros
DSS_MOTORISTAS_ID_FIELD=id
DSS_MOTORISTAS_NAME_FIELD=nome_motorista
# Para desabilitar, defina DSS_MOTORISTAS_PATH com valor vazio.
